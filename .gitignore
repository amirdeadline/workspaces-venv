**/.env
**/env.cmd
**/.claude-code/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Export artifacts
*.zip
